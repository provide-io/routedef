{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "routedef-cloudflare-worker",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
